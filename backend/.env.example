# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/ppe_compliance

# JWT secret used to sign tokens
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# Server port
PORT=5000

# Default admin created by the seed script
DEFAULT_ADMIN_EMAIL=admin@ppe.com
DEFAULT_ADMIN_PASSWORD=Admin@123

# Minutes a violation can stay un-acknowledged before it escalates to the admin Alerts page
ESCALATION_MINUTES=10

# Comma separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173
